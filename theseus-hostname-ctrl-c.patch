diff --git a/tests/test_monitor_protocol.py b/tests/test_monitor_protocol.py
new file mode 100644
index 0000000..1d2222d
--- /dev/null
+++ b/tests/test_monitor_protocol.py
@@ -0,0 +1,126 @@
+"""Check the monitor's acknowledgement protocol without broadcasting signals."""
+
+from pathlib import Path
+import shlex
+import subprocess
+import tempfile
+import unittest
+
+
+REPO = Path(__file__).resolve().parents[1]
+
+
+class MonitorProtocolTests(unittest.TestCase):
+    def test_retry_lost_notification_without_interrupting_active_screen(self):
+        with tempfile.TemporaryDirectory(prefix="theseus-monitor-") as directory:
+            root = Path(directory)
+            state = root / "state"
+            state.mkdir()
+            helper = root / "monitors_lock.bash"
+            helper.write_text(
+                (REPO / "common_functions/monitors_lock.bash").read_text()
+                .replace("/user_shell_files", str(state))
+                .replace("/root/lock", str(root / "monitor.lock"))
+                .replace("/handle_sigint.bash", str(root / "handler.bash"))
+            )
+            script = f"""
+set -e
+source {shlex.quote(str(helper))}
+state={shlex.quote(str(state))}
+notifications=0
+polls=0
+pkill()
+{{
+    [[ $1 == -SIGINT && $2 == bash ]]
+    [[ ! -e "$state/shells_working" ]]
+    notifications=$((notifications + 1))
+    case $notifications in
+        1) : ;; # The first notification arrived while the prompt hook ended.
+        2) touch "$state/shells_working" ;;
+        3)
+            [[ $polls == 3 ]]
+            cat "$state/success_event" > "$state/success_finished"
+            ;;
+        *) return 1 ;;
+    esac
+}}
+sleep()
+{{
+    [[ $1 == 0.1 ]]
+    polls=$((polls + 1))
+    # Leave the screen active for a complete poll, then finish cleanup.
+    if [[ $polls == 3 ]]; then rm "$state/shells_working"; fi
+    [[ $polls -le 4 ]]
+}}
+get_root_lock
+handle_succes_and_release_lock
+[[ $notifications == 3 && $polls == 4 ]]
+[[ ! -e "$state/success_event" && ! -e "$state/success_finished" ]]
+"""
+            result = subprocess.run(
+                ["bash", "-c", script], capture_output=True, text=True, timeout=5
+            )
+            self.assertEqual(result.returncode, 0, result.stderr)
+
+    def test_fast_completion_and_repeated_submission(self):
+        with tempfile.TemporaryDirectory(prefix="theseus-monitor-") as directory:
+            root = Path(directory)
+            state = root / "state"
+            state.mkdir()
+            lock = root / "monitor.lock"
+            handler = root / "handler.bash"
+            log = root / "events"
+            helper = root / "monitors_lock.bash"
+            helper.write_text(
+                (REPO / "common_functions/monitors_lock.bash").read_text()
+                .replace("/user_shell_files", str(state))
+                .replace("/root/lock", str(lock))
+                .replace("/handle_sigint.bash", str(handler))
+            )
+            script = f"""
+set -e
+source {shlex.quote(str(helper))}
+state={shlex.quote(str(state))}
+lock={shlex.quote(str(lock))}
+handler={shlex.quote(str(handler))}
+log={shlex.quote(str(log))}
+
+# Simulate a shell that closes the screen before pkill returns. There is no
+# transient shells_working marker for the monitor to observe in this case.
+pkill()
+{{
+    [[ $1 == -SIGINT && $2 == bash ]]
+    [[ $(cat "$handler") == 'complete handler' ]]
+    [[ ! -e "$state/success_finished" ]]
+    if flock -n "$lock" true; then
+        echo 'Monitor released its serialization lock too early' >&2
+        return 1
+    fi
+    local event
+    IFS= read -r event < "$state/success_event"
+    printf '%s\\n' "$event" >> "$log"
+    printf '%s\\n' "$event" > "$state/success_finished"
+}}
+
+for attempt in 1 2; do
+    get_root_lock
+    printf 'complete handler\\n' > "$handler"
+    printf 'stale acknowledgement\\n' > "$state/success_finished"
+    handle_succes_and_release_lock
+    [[ ! -e "$state/success_event" && ! -e "$state/success_finished" ]]
+    [[ -z $(cat "$handler") ]]
+    flock -n "$lock" true
+done
+"""
+            result = subprocess.run(
+                ["bash", "-c", script], capture_output=True, text=True, timeout=5
+            )
+            self.assertEqual(result.returncode, 0, result.stderr)
+            events = log.read_text().splitlines()
+            self.assertEqual(len(events), 2)
+            self.assertNotEqual(events[0], events[1], "Retries reused an event ID")
+            self.assertEqual(events[0].split(":")[0], events[1].split(":")[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_success_signals.py b/tests/test_success_signals.py
new file mode 100644
index 0000000..206df85
--- /dev/null
+++ b/tests/test_success_signals.py
@@ -0,0 +1,375 @@
+#!/usr/bin/env python3
+"""Exercise success screens in real interactive Bash pseudo-terminals.
+
+Run with ``python3 -m unittest discover -s tests -v``. No Docker daemon,
+provisioning, real challenge accounts, or third-party Python packages are used.
+Only absolute challenge paths are relocated into a temporary directory.
+"""
+
+import errno
+import os
+from pathlib import Path
+import pty
+import re
+import select
+import shlex
+import signal
+import subprocess
+import tempfile
+import time
+import unittest
+
+
+REPO = Path(__file__).resolve().parents[1]
+PROMPT = b"theseus-test> "
+LANGUAGES = {
+    "english": {
+        "user": "center_of_the_labyrinth", "lock": "lock",
+        "objective": "objective", "door": "open_door",
+        "achieved": "achieved_objective", "thread": "thread",
+        "screen": "Are the keys to press on against fear.",
+        "submission": "submission_box", "solution": "solution",
+        "failure": "test (1/5): incorrect solution.",
+        "incorrect": "incorrect_solution", "next": "read",
+        "next_screen": "Password: whole_freaking",
+        "final": "inception", "victory": "famous hero.",
+    },
+    "basque": {
+        "user": "labirintoaren_erdigunea", "lock": "sarraila",
+        "objective": "helburua", "door": "ate_irekia",
+        "achieved": "helburu_lortua", "thread": "haria",
+        "screen": "erabili beharko dituzu",
+        "submission": "aurkezpen_ontzia", "solution": "erantzuna",
+        "failure": "froga (1/5): erantzun ezegokia.",
+        "incorrect": "erantzun_ezegokia", "next": "irakurri",
+        "next_screen": "pasahitza: osoa",
+        "final": "hastapena", "victory": "bat bilakatzeko!!",
+    },
+}
+
+
+class Terminal:
+    def __init__(self, rcfile, home):
+        self.pid, self.fd = pty.fork()
+        if self.pid == 0:
+            os.environ.update(TERM="xterm-256color", HOME=str(home), LC_ALL="C")
+            os.execv("/bin/bash", ["bash", "--noprofile", "--rcfile", str(rcfile), "-i"])
+        self.buffer = b""
+        self.transcript = b""
+        self.expect(PROMPT)
+
+    def send(self, data):
+        os.write(self.fd, data.encode() if isinstance(data, str) else data)
+
+    def read(self, timeout):
+        if not select.select([self.fd], [], [], timeout)[0]:
+            return b""
+        try:
+            data = os.read(self.fd, 65536)
+        except OSError as error:
+            if error.errno == errno.EIO:
+                raise AssertionError("Interactive Bash exited unexpectedly") from error
+            raise
+        if not data:
+            raise AssertionError("Interactive Bash closed its terminal")
+        self.buffer += data
+        self.transcript += data
+        return data
+
+    def expect(self, token, timeout=5):
+        token = token.encode() if isinstance(token, str) else token
+        end = time.monotonic() + timeout
+        while token not in self.buffer:
+            remaining = end - time.monotonic()
+            if remaining <= 0:
+                raise AssertionError(f"Missing {token!r}; terminal tail: {self.transcript[-2500:]!r}")
+            self.read(remaining)
+        before, self.buffer = self.buffer.split(token, 1)
+        return before + token
+
+    def command(self, command):
+        self.send(command + "\n")
+        return self.expect(PROMPT)
+
+    def terminal_mode(self):
+        output = self.command("stty -g")
+        match = re.search(rb"([0-9a-f]+(?::[0-9a-f]+){5,})\r\n", output)
+        if not match:
+            raise AssertionError(f"Could not read terminal mode: {output!r}")
+        return match.group(1)
+
+    def close(self):
+        try:
+            os.kill(self.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+        os.waitpid(self.pid, 0)
+        os.close(self.fd)
+
+
+class Fixture:
+    def __init__(self, language):
+        self.language = language
+        self.names = LANGUAGES[language]
+        self.temporary = tempfile.TemporaryDirectory(prefix="theseus-signals-")
+        self.root = Path(self.temporary.name)
+        self.state = self.root / "user_shell_files"
+        self.state.mkdir()
+        self.home = self.root / "home" / self.names["user"]
+        self.make_challenge(self.names["user"])
+        self.handler = self.root / "handle_sigint.bash"
+        self.handler.write_text("")
+        self.rcfile = self.root / "bashrc"
+        self.shell_file = self.root / "shell.pid"
+        self.event_number = 0
+
+        # Some containers expose /proc from a different PID namespace. Provide
+        # the same two process-group queries using the live terminal and POSIX
+        # calls; all locking, read, stty, traps and game code remain real.
+        ps_helper = self.root / "ps_groups.py"
+        ps_helper.write_text(
+            "import os, sys\n"
+            "field = sys.argv[1]\n"
+            "print(os.getpgid(int(sys.argv[2])) if field == 'pgid=' else os.tcgetpgrp(0))\n"
+        )
+        startup = (
+            "PS1='theseus-test> '\n"
+            "PROMPT_COMMAND=\n"
+            f"printf '%s\\n' \"$$\" > {shlex.quote(str(self.shell_file))}\n"
+            "ps() {\n"
+            "  if [[ $1 == -o && ( $2 == pgid= || $2 == tpgid= ) && $3 == -p ]]; then\n"
+            f"    {shlex.quote(os.sys.executable)} {shlex.quote(str(ps_helper))} \"$2\" \"$4\"\n"
+            "  else command ps \"$@\"; fi\n"
+            "}\n"
+        )
+        wrapper = REPO / "common_functions" / "shell_signal_handler.bash"
+        if wrapper.exists():
+            local_wrapper = self.root / "shell_signal_handler.bash"
+            local_wrapper.write_text(self.relocate(wrapper.read_text()))
+            startup += f"source {shlex.quote(str(local_wrapper))}\n"
+        else:
+            # This also allows the tests to demonstrate the original regression.
+            startup += f"trap 'source {self.handler}' SIGINT\n"
+        self.rcfile.write_text(startup)
+        self.terminal = Terminal(self.rcfile, self.home)
+
+    def relocate(self, text):
+        return (text.replace("/user_shell_files", str(self.state))
+                .replace("/home/", str(self.root / "home") + "/")
+                .replace("/handle_sigint.bash", str(self.handler)))
+
+    def make_challenge(self, user):
+        home = self.root / "home" / user
+        (home / self.names["lock"]).mkdir(parents=True)
+        (home / self.names["objective"]).write_text("challenge\n")
+        return home
+
+    def activate(self, name, pid=None, at_prompt=True):
+        if at_prompt:
+            self.terminal.send("__event_interrupt_probe__")
+            self.terminal.expect(b"__event_interrupt_probe__")
+            # Even clean Bash can lose its prompt when synthetic Ctrl+C lands
+            # during immediate redisplay. Pace this like ordinary keyboard input.
+            time.sleep(0.005)
+        common = (REPO / "common_functions/handle_success.bash").read_text()
+        localized = (REPO / self.language / "user_monitoring_scripts" / f"{name}_handle_success.bash").read_text()
+        self.handler.write_text(self.relocate(common + "\n" + localized))
+        self.event_number += 1
+        (self.state / "success_event").write_text(f"{os.getpid()}:{self.event_number}\n")
+        os.kill(pid or self.terminal.pid, signal.SIGINT)
+
+    def assert_released(self, case):
+        for marker in ("foreground_activated", "shells_working", "user_shell_count"):
+            case.assertFalse((self.state / marker).exists(), f"Leaked success marker: {marker}")
+        lock = subprocess.run(["flock", "-n", str(self.state / "lock"), "true"], timeout=2)
+        case.assertEqual(lock.returncode, 0, "Success flock is still held")
+        output = self.terminal.command(
+            "if ( : >&200 ) 2>/dev/null; then echo descriptor_open; else echo descriptor_closed; fi"
+        )
+        case.assertRegex(output, rb"\rdescriptor_closed\r\n|\r\ndescriptor_closed\r\n")
+
+    def assert_terminal_works(self, case):
+        # Readline must echo new input after returning to the ordinary prompt.
+        self.terminal.send("__echo_probe__")
+        self.terminal.expect(b"__echo_probe__")
+        self.terminal.send(b"\x15\n")
+        self.terminal.expect(PROMPT)
+        response = self.terminal.command("stty -a")
+        case.assertNotIn(b"-isig", response)
+        case.assertNotIn(b"-icanon", response)
+        case.assertNotIn(b"-echo ", response)
+
+    def close(self):
+        self.terminal.close()
+        self.temporary.cleanup()
+
+
+class SuccessSignalTests(unittest.TestCase):
+    def fixture(self, language):
+        fixture = Fixture(language)
+        self.addCleanup(fixture.close)
+        return fixture
+
+    def dismiss_after_interrupts(self, fixture, screen, pid=None):
+        terminal = fixture.terminal
+        terminal.expect(screen)
+        # Let Bash enter read -n1, which changes termios after displaying text.
+        time.sleep(0.05)
+        terminal.send(b"\x03\x03\x03")
+        os.kill(pid or terminal.pid, signal.SIGINT)
+        terminal.read(0.15)
+        self.assertNotIn(PROMPT, terminal.buffer, "Ctrl+C escaped the success screen")
+        terminal.send(b" ")
+        output = terminal.expect(PROMPT)
+        self.assertIn(b"\x1b[?25h", output, "Cursor was not made visible again")
+        fixture.assert_released(self)
+        self.assertEqual((fixture.state / "success_finished").read_text().strip(),
+                         (fixture.state / "success_event").read_text().strip())
+        # The monitor may not have cleared its published event yet. Another
+        # signal must not replay the same handler or repeat its file moves.
+        # Synchronize on echoed input: prompt bytes can precede Readline's
+        # readiness to process keys. Ctrl+C must cancel this unfinished line.
+        terminal.send("__duplicate_interrupt_probe__")
+        terminal.expect(b"__duplicate_interrupt_probe__")
+        # Match the keyboard pacing above; interrupts inside the screen remain rapid.
+        time.sleep(0.005)
+        terminal.send(b"\x03")
+        terminal.expect(PROMPT)
+        terminal.send("printf '__duplicate_signal_returned__\\n'\n")
+        duplicate_output = terminal.expect(b"__duplicate_signal_returned__\r\n")
+        terminal.expect(PROMPT)
+        self.assertNotIn(b"No such file", duplicate_output)
+        fixture.assert_released(self)
+        fixture.handler.write_text("")  # The monitor clears the completed event.
+        (fixture.state / "success_event").unlink()
+        fixture.assert_terminal_works(self)
