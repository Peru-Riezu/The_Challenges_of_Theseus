+    def test_ctrl_c_without_a_pending_event(self):
+        fixture = self.fixture("english")
+        terminal = fixture.terminal
+        # At an ordinary prompt Ctrl+C still discards the unfinished command.
+        sentinel = fixture.root / "must-not-be-created"
+        terminal.send(f"touch {shlex.quote(str(sentinel))}")
+        terminal.expect(b"must-not-be-created")
+        terminal.send(b"\x03")
+        terminal.expect(PROMPT)
+        self.assertFalse(sentinel.exists())
+        # It must also interrupt a foreground command normally.
+        terminal.send("printf 'foreground_started\\n'; sleep 5\n")
+        terminal.expect(b"foreground_started\r\n")
+        time.sleep(0.05)
+        terminal.send(b"\x03")
+        terminal.expect(PROMPT, timeout=2)
+        fixture.assert_terminal_works(self)
+
